# =============================================================================
# QRDineX — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Use the POOLED connection string for the application (Next.js runtime).
# Neon pooled connections use PgBouncer — efficient for serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Use the DIRECT (non-pooled) connection string for Prisma migrations.
# Prisma migrate dev requires a direct connection; pooled connections
# do not support the PostgreSQL advisory locks used during migrations.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# MUST be a long, random string (minimum 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-minimum-64-character-random-hex-string"

# -----------------------------------------------------------------------------
# APPLICATION DOMAIN / DEPLOYMENT URL
# -----------------------------------------------------------------------------
# Local: "http://localhost:3000"
# Render Production: "https://<your-render-app-name>.onrender.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# CUSTOM SERVER (Socket.IO)
# -----------------------------------------------------------------------------
# Port the custom Node.js server listens on.
# Render sets PORT automatically — do not hardcode in production.
# Default is 3000 for local development.
PORT=3000

# -----------------------------------------------------------------------------
# DATABASE SEED
# -----------------------------------------------------------------------------
# Default password for the Super Admin account created by `npm run db:seed`.
# Override before running the seed in any environment.
# Change this immediately after first login.
SEED_ADMIN_PASSWORD="QRDineX@Admin2026!"

# -----------------------------------------------------------------------------
# CLOUDINARY (Image Storage)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
